--- !u!114 &1570057951151987764
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8752391552012232464}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ab258e9239cfef8449775ffba5c54f28, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  triggerMode: 0
  triggerDistance: 1
  dialogueBox: {fileID: 986251184522485429}
  playerDialogueBox: {fileID: 105759976}
  goldText: {fileID: 9116384277093103067}
  playerText: {fileID: 375915074}
  goldImage: {fileID: 1333662031}
  dialogueEntries:
  - text: "\xB7\xB7\xB7\xB7\xB7\xB7\uFF1F"
    isGoldSpeaking: 0
    emotionIcon: {fileID: 0}
  - text: "\xB7\xB7\xB7\u4E0D\u5BF9\uFF01"
    isGoldSpeaking: 0
    emotionIcon: {fileID: 0}
  - text: "\u8FD9\u5230\u5E95\u662F\u600E\u4E48\u56DE\u4E8B\u554A\uFF01\uFF01\uFF01"
    isGoldSpeaking: 0
    emotionIcon: {fileID: 0}
  - text: "\u5514\xB7\xB7\xB7\xB7\xB7\xB7\u606D\u559C\u4F60\uFF01\uFF01\uFF01"
    isGoldSpeaking: 1
    emotionIcon: {fileID: 0}
  - text: "\u4F60\u53EF\u662F\u88AB\u5F02\u4E16\u754C\u9009\u4E2D\u7684\u5929\u9009\u4E4B\u5B50\uFF01"
    isGoldSpeaking: 1
    emotionIcon: {fileID: 0}
  - text: "\u4EC0\u4E48\u4E71\u4E03\u516B\u7CDF\u7684\uFF01\u8FD8\u6211\u624B\u673A\uFF01"
    isGoldSpeaking: 0
    emotionIcon: {fileID: 0}
  - text: "\u7A0D\u5B89\u52FF\u8E81\uFF0C\u8BA9\u6211\u5148\u4E3A\u4F60\u4ECB\u7ECD\xB7\xB7\xB7"
    isGoldSpeaking: 1
    emotionIcon: {fileID: 0}
  - text: "\u4F11\u60F3\u8F6C\u79FB\u8BDD\u9898\uFF01"
    isGoldSpeaking: 0
    emotionIcon: {fileID: 0}
  - text: "\u5C11\u5728\u8FD9\u5751\u8499\u62D0\u9A97\u7684\uFF01"
    isGoldSpeaking: 0
    emotionIcon: {fileID: 0}
  - text: "\u545C\u54C7\u54C7\u54C7\u5BF9\u4E0D\u8D77\u561B\uFF01\u8FD9\u4E48\u51F6\u5E72\u561B\uFF01"
    isGoldSpeaking: 1
    emotionIcon: {fileID: 0}
  - text: "\u4F60\u8FD9\u662F\u809D\u706B\u592A\xB7\xB7\xB7\xB7\xB7\xB7"
    isGoldSpeaking: 1
    emotionIcon: {fileID: 0}
  - text: "\xB7\xB7\xB7\xB7\xB7\xB7"
    isGoldSpeaking: 0
    emotionIcon: {fileID: 0}
  - text: "\u54B3\u54B3\u2014\u2014\u597D\u5427\uFF01\u5176\u5B9E\xB7\xB7\xB7"
    isGoldSpeaking: 1
    emotionIcon: {fileID: 0}
  - text: "\u6211\u7761\u8FF7\u7CCA\u4E86\u4E0D\u5C0F\u5FC3\u628A\u95E8\u6253\u5F00\u4E86\uFF0C"
    isGoldSpeaking: 1
    emotionIcon: {fileID: 0}
  - text: "\u7136\u540E\u5C31\u5982\u4F60\u6240\u89C1\xB7\xB7\xB7\xB7\xB7\xB7"
    isGoldSpeaking: 1
    emotionIcon: {fileID: 0}
  - text: "\u545C\u54C7\u54C7\u54C7\u5BF9\u4E0D\u8D77\u561B\uFF01\uFF01\uFF01"
    isGoldSpeaking: 1
    emotionIcon: {fileID: 0}
  - text: "\u54B3\u54B3-\u603B\u4E4B\u6211\u4EEC\u8981\u5B66\u4F1A\u63A5\u53D7\u73B0\u5B9E"
    isGoldSpeaking: 1
    emotionIcon: {fileID: 0}
  - text: "\u6240\u4EE5\u524D\u5F80\u5730\u5E95\u627E\u56DE\u4F60\u7684\u624B\u673A\u5427\uFF01"
    isGoldSpeaking: 1
    emotionIcon: {fileID: 0}
  - text: "\u7EC6\u5FC3\u548C\u8010\u5FC3\u5C06\u6210\u4E3A\u4F60\u6700\u5927\u7684\u6B66\u5668\uFF01"
    isGoldSpeaking: 1
    emotionIcon: {fileID: 0}
  - text: "\u5582\u2014\u2014\uFF01\uFF01\uFF01\uFF01\uFF01\uFF01"
    isGoldSpeaking: 0
    emotionIcon: {fileID: 0}
  - text: "\u597D\u5427\uFF01\u770B\u5728\u4F60\u662F\u5F02\u4E16\u754C\u65B0\u4EBA\u7684\u9762\u5B50\u4E0A"
    isGoldSpeaking: 1
    emotionIcon: {fileID: 0}
  - text: "\u6211\u5C06\u7ED9\u4F60\u4E00\u4E2A\u5F88\u5389\u5BB3\u7684\u9053\u5177"
    isGoldSpeaking: 1
    emotionIcon: {fileID: 0}
  - text: "\u62FF\u8D77\u90A3\u628A\u5251\u5F00\u542F\u4F60\u7684\u5F02\u4E16\u754C\u4E4B\u65C5\u5427\uFF01"
    isGoldSpeaking: 1
    emotionIcon: {fileID: 0}
  typingSpeed: 0.05
  startDelay: 0.2
  emotionIconScaleDuration: 0.3
  autoStartDelay: 1
  dialogueBrokein: 0
  dialogueActive: 0
  dialogueCompleted: 0
  player: {fileID: 0}
