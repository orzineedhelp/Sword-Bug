  angryIcon: {fileID: 0}
  animator: {fileID: 0}
  goldObject: {fileID: 4996377628543654473}
  dialogueEntries:
  - isNPC: 1
    text: "\u770B\u6765\u8FDB\u5C55\u5F88\u987A\u5229\u561B\uFF01\u4E2D\u9014\u542C\u4E0D\u5230\u4F60\u7684\u58F0\u97F3\u6211\u8FD8\u5F88\u62C5\u5FC3\u6765\u7740"
    triggerShake: 0
  - isNPC: 0
    text: "\xB7\xB7\xB7\u4F60\u8FD9\u4E2A\u4E0D\u9760\u8C31\u7684\u5BB6\u4F19\uFF0C\u8BF4\u5230\u5E95\u8FD9\u4E2A\u4E16\u754C\u5C31\u5168\u662Fbug\u5427\uFF01\uFF01"
    triggerShake: 0
  - isNPC: 1
    text: "\u4EC0\xB7\xB7\xB7\u4EC0\u4E48\uFF01\u4F60\u8FD9\u5BB6\u4F19\u53EF\u4E0D\u80FD\u4E71\u8BB2\uFF0C\u6211\u53EA\u662F\u4E0D\u5C0F\u5FC3\u6253\u5F00\u4E86\u5F02\u4E16\u754C\u7684\u8FDE\u901A\u5927\u95E8"
    triggerShake: 0
  - isNPC: 0
    text: "\u660E\u660E\u662F\u5251\u5374\u65E0\u6CD5\u653B\u51FB\uFF0C\u8FD9\u771F\u7684\u4E0D\u662Fbug\u5417\uFF1F"
    triggerShake: 0
  - isNPC: 0
    text: "\u6211\u7684\u79FB\u52A8\u7A81\u7136\u53D8\u5316\u4E86\uFF0C\u8FD9\u771F\u7684\u4E0D\u662Fbug\u5417\uFF01\uFF1F"
    triggerShake: 0
  - isNPC: 0
    text: "\u6211\u7684\u8EAB\u4F53\u4E00\u76F4\u5728\u53D8\u5927\u53D8\u5C0F\uFF0C\u8FD9\u771F\u7684\u4E0D\u662Fbug\u5417\uFF01\uFF01\uFF1F"
    triggerShake: 0
  - isNPC: 0
    text: "\u4E0D\u662F\u6D88\u9664\u65B9\u5757\u800C\u662F\u7838\u5899\u9003\u51FA\u6765\u7684\u4FC4\u7F57\u65AF\u65B9\u5757\uFF0C\u8FD9\u771F\u7684\u4E0D\u662Fbug\u5417\uFF01\uFF01\uFF01\uFF1F"
    triggerShake: 0
  typingSpeed: 0.05
  startDelay: 0.2
  enableShakeEffect: 1
  baseShakeIntensity: 2
  shakeIntensityIncrement: 0.8
