--- !u!114 &3020217871363809645
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4996377628543654473}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ab258e9239cfef8449775ffba5c54f28, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  goldTargetPosition: {fileID: 0}
  triggerDistance: 1
  dialogueBox: {fileID: 0}
  goldText: {fileID: 0}
  playerText: {fileID: 0}
  goldImage: {fileID: 0}
  playerImage: {fileID: 0}
  dialogueEntries:
  - text: "......,\u8FD9...,\u8FD9\u5230\u5E95\u600E\u4E48\u56DE\u4E8B\u554A\uFF01\uFF01\uFF01"
    isGoldSpeaking: 0
    emotionIcon: {fileID: 0}
  - text: "\u5BF9...\u4E0D\u5BF9\u8D77,\u6211\u4E0D\u5C0F\u5FC3\u7761\u8FF7\u7CCA\u4E86\uFF0C\u6253\u5F00\u4E86\u5F02\u4E16\u754C\u7684\u5927\u95E8\uFF0C.\u4F60\u7684\u624B\u673A\u6389\u843D\u81F3\u5F02\u4E16\u754C\u7BA1\u63A7\u4E2D\u5FC3"
    isGoldSpeaking: 1
    emotionIcon: {fileID: 0}
  - text: "\u6211\u7684\u624B\u673A\u6389\u91CC\u9762\u53BB\u4E86\uFF01\uFF01\uFF1F\u90A3\u600E\u4E48\u62FF\u56DE\u6765\u554A\uFF1F"
    isGoldSpeaking: 0
    emotionIcon: {fileID: 0}
  - text: "\u8FD9\u4E2A\u9700\u8981\u4F60\u81EA\u5DF1\u62FF\u56DE\u6765...\u653E\u5FC3\u4F60\u5230\u4E86\u7BA1\u63A7\u4E2D\u5FC3\u6211\u4E00\u5B9A\u628A\u4F60\u9001\u56DE\u6765\u3002"
    isGoldSpeaking: 1
    emotionIcon: {fileID: 0}
  - text: "\u6211\u76F8\u4FE1\uFF0C\u4F60\u7EC6\u81F4\u7684\u6D1E\u5BDF\u529B\u4EE5\u53CA\u5927\u80C6\u7684\u60F3\u8C61\u529B\u5C06\u4F1A\u6210\u4E3A\u4F60\u6700\u5389\u5BB3\u7684\u6B66\u5668\uFF01"
    isGoldSpeaking: 1
    emotionIcon: {fileID: 0}
  - text: "\u5149\u753B\u997C\u662F\u5427\uFF01\u4ECA\u5929\u4E0D\u7206\u70B9\u795E\u88C5\u51FA\u6765\uFF0C\u6211\u4E3E\u62A5\u4F60\u4E0A\u73ED\u6478\u9C7C\u8FF7\u8FF7\u7CCA\u7CCA\u917F\u6210\u5927\u9519\uFF01"
    isGoldSpeaking: 0
    emotionIcon: {fileID: 0}
  typingSpeed: 0.05
  startDelay: 0.2
  emotionIconScaleDuration: 0.3
